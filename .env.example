# ---- Aplikasi ----
PORT=3000
NODE_ENV=production
# URL publik situs Anda (tanpa slash di akhir), dipakai untuk return_url pembayaran
APP_URL=https://nokos.contoh.com
# Folder database SQLite (harus persistent disk/volume!)
DATA_DIR=./data

# ---- Provider nomor OTP (format SMS-Activate) ----
PROVIDER_BASE_URL=https://api.provider-anda.com/stubs/handler_api.php
PROVIDER_API_KEY=

# ---- Tripay ----
# TRIPAY_MODE: sandbox (uji coba) atau production
TRIPAY_MODE=sandbox
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
